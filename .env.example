# Copy to .env in this folder — never commit .env
# Used by meta/sync_meta_insights.py

META_ACCESS_TOKEN=your_long_lived_user_or_system_token
META_AD_ACCOUNT_ID=act_1234567890
META_API_VERSION=v21.0

# Inclusive YYYY-MM-DD (defaults to last 30 days if blank)
META_DATE_START=
META_DATE_END=

# Optional: single campaign id
META_CAMPAIGN_ID=

META_OUT_CSV=meta/out/meta_daily_insights.csv
