# Copy to AuthorDashboard/.env (project root) — never commit .env
# Meta Marketing API — https://developers.facebook.com/docs/marketing-apis

META_ACCESS_TOKEN=your_long_lived_user_or_system_token
META_AD_ACCOUNT_ID=act_1234567890
META_API_VERSION=v21.0

# Inclusive date range (YYYY-MM-DD). Defaults to last 30 days if omitted.
META_DATE_START=
META_DATE_END=

# Optional: filter to one campaign id (digits only, stored as text in CSV)
META_CAMPAIGN_ID=

# Output path relative to project root
META_OUT_CSV=meta/out/meta_daily_insights.csv
